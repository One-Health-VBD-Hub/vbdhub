{
  "name": "vbdhub",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev:web": "pnpm --filter @vbdhub/web run dev",
    "dev:service2": "pnpm --filter @vbdhub/service2 run dev",
    "db:prisma:generate": "pnpm --filter @vbdhub/db run prisma:generate",
    "db:prisma:migrate:dev": "pnpm --filter @vbdhub/db run prisma:migrate:dev",
    "db:prisma:migrate:deploy": "pnpm --filter @vbdhub/db run prisma:migrate:deploy"
  },
  "prettier": {
    "singleQuote": true,
    "jsxSingleQuote ": true,
    "trailingComma": "none"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
