{
  "name": "vbdhub",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev:web": "pnpm -F @vbdhub/web run dev",
    "dev:service2": "pnpm -F @vbdhub/service2 run dev",
    "db:prisma:generate": "pnpm -F @vbdhub/db run prisma:generate",
    "db:prisma:migrate:dev": "pnpm -F @vbdhub/db run prisma:migrate:dev",
    "db:prisma:migrate:deploy": "pnpm -F @vbdhub/db run prisma:migrate:deploy"
  },
  "prettier": {
    "singleQuote": true,
    "jsxSingleQuote": true,
    "trailingComma": "none",
    "printWidth": 100
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3"
  }
}
