// Goals:
// - PostgreSQL + PostGIS as the primary store
// - One taxonomy DB: GBIF backbone only
// - Datasets from multiple SourceDb values with heterogeneous per-source metadata in `raw`
// - Filters you care about: taxonomy (by GBIF IDs + “under rank X”), location, publishedAt, category, sourceDb
//
// Key design choices:
// - Taxonomy is normalized into a Taxon table (one row per GBIF usageKey)
// - Dataset ↔ Taxon is many-to-many via DatasetTaxon (one row per dataset–taxon relationship)
// - “Under class/order/family/genus…” is supported *simply* via denormalized lineage columns on Taxon
//   (classId/orderId/familyId/genusId/etc). This avoids recursive queries or a closure table.
//
// Notes on PostGIS + Prisma:
// - Prisma does not natively support PostGIS geometry/geography types, so we use Unsupported(...)
// - You will query spatial predicates (ST_Intersects / ST_Within / ST_DWithin / etc.) via $queryRaw,
//   ideally wrapped in Prisma Client extensions + SafeQL.
//
// Notes on metadata search:
// - If you only search over metadata (datasets), Postgres full-text search is usually sufficient.
//   You can add a generated tsvector + GIN index in a SQL migration (Prisma doesn't model tsvector well).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SourceDb {
  // Source systems whose dataset metadata we ingest and unify
  gbif
  proteomexchange
  vecdyn
  vectraits
  hub
}

enum DatasetCategory {
  // High-level category used for filtering and UI grouping
  occurrence
  abundance
  traits
  proteomics
  epidemiology
}

enum TaxonRank {
  // Normalized ranks for consistent filterin
  kingdom
  phylum
  class
  order
  family
  genus
  species
  subspecies
}

model Dataset {
  /// Internal canonical ID used across VBD Hub
  id String @id @default(cuid(2))

  /// Source database + key in that database (stable ID)
  /// e.g. GBIF datasetKey, ProteomeXchange accession, VecTraits dataset ID, etc.
  sourceDb  SourceDb
  sourceKey String

  /// Shared searchable/display fields (keep these “canonical” as real columns)
  /// Everything else can live in `raw` for heterogeneous per-source differences.
  title       String?
  description String?
  homepageUrl String?
  doi         String?
  publisher   String?
  license     String?
  category    DatasetCategory

  /// Date the dataset was published/released at the source (your “date of publishing” filter)
  publishedAt DateTime?

  /// Heterogeneous per-source metadata blob (store the entire source payload or a mapped subset)
  raw Json @default("{}")

  /// Spatial footprint / coverage.
  /// Store ANY geometry (Point/Polygon/MultiPolygon/GeometryCollection) in SRID 4326.
  /// You’ll query this with raw SQL (ST_Intersects / ST_Within / etc.).
  spatialGeom Unsupported("geometry(GEOMETRY, 4326)")?

  /// Optional convenience bbox columns for cheap prefiltering (can help before PostGIS ops)
  /// Useful if you want a quick “bbox overlaps” check before expensive geometry predicates.
  bboxMinLon Float? @db.DoublePrecision
  bboxMinLat Float? @db.DoublePrecision
  bboxMaxLon Float? @db.DoublePrecision
  bboxMaxLat Float? @db.DoublePrecision

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Taxonomic coverage tags for filtering (many-to-many via join)
  taxa DatasetTaxon[]

  @@unique([sourceDb, sourceKey])
  // Common filters
  @@index([sourceDb])
  @@index([category])
  @@index([publishedAt])
  @@index([sourceDb, category, publishedAt])
  // Optional if DOIs are common and frequently queried
  @@index([doi])
}

model Taxon {
  /// GBIF backbone usageKey (integer identifier)
  /// You said you want to stick to GBIF as the single taxonomy DB.
  gbifTaxonId Int @id

  /// Display name (GBIF scientificName or your preferred canonical display)
  scientificName String

  /// Normalized name for reliable, indexed matching from user input
  /// Recommended: store lower(trim(scientificName)) (and optionally ASCII-fold) during ingest
  /// Example: "Anopheles" -> "anopheles"
  nameNorm String

  /// Normalized rank for “show all genus / family / class …”
  rank TaxonRank?

  /// Optional parent pointer (not required for querying if lineage columns are populated)
  /// Useful if you later want to rebuild lineage columns or debug taxonomy.
  parentGbifTaxonId Int?
  parent            Taxon?  @relation("TaxonParent", fields: [parentGbifTaxonId], references: [gbifTaxonId], onDelete: Restrict)
  children          Taxon[] @relation("TaxonParent")

  /// The “simple but powerful” part:
  /// store the IDs of the ancestor at each major rank.
  ///
  /// This enables “under X” queries without recursive CTEs or closure tables:
  /// - “under class Insecta” => taxon.classId = insectaId
  /// - “under family Culicidae and phylum Arthropoda” => taxon.familyId = culicidaeId AND taxon.phylumId = arthropodaId
  ///
  /// Populate these once per Taxon at ingest time from the GBIF backbone lineage.
  kingdomId          Int?
  kingdomTaxon       Taxon?  @relation("TaxonKingdom", fields: [kingdomId], references: [gbifTaxonId], onDelete: Restrict)
  kingdomDescendants Taxon[] @relation("TaxonKingdom")

  phylumId          Int?
  phylumTaxon       Taxon?  @relation("TaxonPhylum", fields: [phylumId], references: [gbifTaxonId], onDelete: Restrict)
  phylumDescendants Taxon[] @relation("TaxonPhylum")

  classId          Int?
  classTaxon       Taxon?  @relation("TaxonClass", fields: [classId], references: [gbifTaxonId], onDelete: Restrict)
  classDescendants Taxon[] @relation("TaxonClass")

  orderId          Int?
  orderTaxon       Taxon?  @relation("TaxonOrder", fields: [orderId], references: [gbifTaxonId], onDelete: Restrict)
  orderDescendants Taxon[] @relation("TaxonOrder")

  familyId          Int?
  familyTaxon       Taxon?  @relation("TaxonFamily", fields: [familyId], references: [gbifTaxonId], onDelete: Restrict)
  familyDescendants Taxon[] @relation("TaxonFamily")

  genusId          Int?
  genusTaxon       Taxon?  @relation("TaxonGenus", fields: [genusId], references: [gbifTaxonId], onDelete: Restrict)
  genusDescendants Taxon[] @relation("TaxonGenus")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  datasets DatasetTaxon[]

  // Name/rank lookups (e.g., user types “anopheles”)
  @@index([rank])
  @@index([nameNorm])
  @@index([rank, nameNorm])
  // Fast “under X” filters
  @@index([kingdomId])
  @@index([phylumId])
  @@index([classId])
  @@index([orderId])
  @@index([familyId])
  @@index([genusId])
}

model DatasetTaxon {
  datasetId String
  dataset   Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  /// GBIF backbone usageKey
  gbifTaxonId Int
  taxon       Taxon @relation(fields: [gbifTaxonId], references: [gbifTaxonId], onDelete: Restrict)

  /// Relationship-specific metadata can go here if needed later (optional):
  /// - evidence/source (“declared in metadata” vs “inferred”)
  /// - extraction method/version
  /// - confidence score, etc.

  // One row per dataset–taxon relationship (prevents duplicates for the same pair)
  @@id([datasetId, gbifTaxonId])
  // Filter acceleration: given many GBIF taxon IDs, find datasets
  @@index([gbifTaxonId, datasetId])
}

// Operational notes (apply via SQL migrations):
//
// 1) PostGIS index for spatial queries (Prisma can't express GiST on Unsupported well):
//    CREATE INDEX dataset_spatial_gist ON "Dataset" USING GIST ("spatialGeom");
//
// 2) If you want fuzzy/partial name matching for Taxon lookup (“anoph…”), enable pg_trgm:
//    CREATE EXTENSION IF NOT EXISTS pg_trgm;
//    CREATE INDEX taxon_name_trgm ON "Taxon" USING GIN ("nameNorm" gin_trgm_ops);
//
// 3) If you want metadata full-text search on Dataset, add tsvector + GIN in SQL migration:
//    (example)
//    ALTER TABLE "Dataset" ADD COLUMN search_vector tsvector
//      GENERATED ALWAYS AS (
//        setweight(to_tsvector('english', coalesce(title,'')), 'A') ||
//        setweight(to_tsvector('english', coalesce(description,'')), 'B') ||
//        setweight(to_tsvector('simple', coalesce(publisher,'')), 'C') ||
//        setweight(to_tsvector('simple', coalesce(doi,'')), 'C')
//      ) STORED;
//    CREATE INDEX dataset_search_gin ON "Dataset" USING GIN (search_vector);
