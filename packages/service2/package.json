{
  "name": "@vbdhub/service2",
  "version": "1.0.0",
  "main": "app.ts",
  "scripts": {
    "start": "pnpm run build:ts && fastify start -l info dist/app.js",
    "build:ts": "pnpm -F @vbdhub/db run build && tsc",
    "watch:ts": "tsc -w",
    "dev": "pnpm run build:ts && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"pnpm:watch:ts\" \"pnpm:dev:start\"",
    "dev:start": "fastify start --ignore-watch=.ts$ -w -l info -P dist/app.js",
    "knip": "knip"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@fastify/autoload": "^6.3.1",
    "@fastify/basic-auth": "^6.2.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@fastify/under-pressure": "^9.0.3",
    "@sentry/node": "^10.53.1",
    "@terraformer/wkt": "^2.2.1",
    "@turf/rewind": "^7.3.5",
    "@vbdhub/db": "workspace:^",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "fastify-cli": "^8.0.0",
    "fastify-plugin": "^5.1.0",
    "keyv": "^5.6.0"
  },
  "devDependencies": {
    "@fastify/type-provider-json-schema-to-ts": "^5.0.0",
    "@prisma/client": "^7.8.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.19.19",
    "concurrently": "^9.2.1",
    "fastify-tsconfig": "^3.0.0",
    "knip": "latest",
    "typescript": "^5.9.3"
  }
}
