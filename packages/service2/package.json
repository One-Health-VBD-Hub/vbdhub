{
  "name": "@vbdhub/service2",
  "version": "1.0.0",
  "main": "app.ts",
  "scripts": {
    "start": "pnpm run build:ts && fastify start -l info dist/app.js",
    "build:ts": "pnpm -F @vbdhub/db run build && tsc",
    "watch:ts": "tsc -w",
    "dev": "pnpm run build:ts && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"pnpm:watch:ts\" \"pnpm:dev:start\"",
    "dev:start": "fastify start --ignore-watch=.ts$ -w -l info -P dist/app.js",
    "knip": "knip"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@fastify/autoload": "^6.5.1",
    "@fastify/basic-auth": "^6.3.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/sensible": "^6.0.7",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@fastify/under-pressure": "^9.2.1",
    "@sentry/node": "^11.0.0",
    "@terraformer/wkt": "^2.2.2",
    "@turf/rewind": "^7.4.0",
    "@vbdhub/db": "workspace:^",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8",
    "fastify-cli": "^8.0.3",
    "fastify-plugin": "^6.0.1",
    "keyv": "^5.6.0"
  },
  "devDependencies": {
    "@fastify/type-provider-json-schema-to-ts": "^5.0.1",
    "@prisma/client": "^7.10.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.4",
    "concurrently": "^10.0.6",
    "fastify-tsconfig": "^3.0.0",
    "knip": "latest",
    "typescript": "^6.0.3"
  }
}
