{
  "name": "@vbdhub/service2",
  "version": "1.0.0",
  "main": "app.ts",
  "scripts": {
    "start": "npm run build:ts && fastify start -l info dist/app.js",
    "build:ts": "tsc",
    "watch:ts": "tsc -w",
    "dev": "npm run build:ts && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"npm:watch:ts\" \"npm:dev:start\"",
    "dev:start": "fastify start --ignore-watch=.ts$ -w -l info -P dist/app.js",
    "knip": "knip"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@fastify/autoload": "^6",
    "@fastify/basic-auth": "^6",
    "@fastify/helmet": "^13",
    "@fastify/rate-limit": "^10",
    "@fastify/sensible": "^6",
    "@fastify/swagger": "^9",
    "@fastify/swagger-ui": "^5",
    "@fastify/under-pressure": "^9",
    "@prisma/adapter-pg": "^7",
    "@prisma/client": "^7",
    "fastify": "^5",
    "fastify-cli": "^7",
    "fastify-plugin": "^5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@fastify/type-provider-json-schema-to-ts": "^5",
    "fastify-tsconfig": "^3",
    "knip": "latest",
    "concurrently": "^9",
    "prisma": "^7",
    "typescript": "^5"
  }
}
