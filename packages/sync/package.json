{
  "name": "@vbdhub/sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm -F @vbdhub/db run build && tsc",
    "sync": "node dist/cli.js",
    "sync:gbif": "pnpm run sync --job gbif",
    "sync:hub": "pnpm run sync --job hub",
    "sync:px": "pnpm run sync --job px",
    "sync:vd": "pnpm run sync --job vd",
    "sync:vt": "pnpm run sync --job vt"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@vbdhub/db": "workspace:^",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.4.2",
    "ky": "^2.0.2",
    "minio": "^8.0.7",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@prisma/client": "^7.8.0",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^22.19.20",
    "typescript": "^5.9.3"
  }
}
