{
  "name": "@vbdhub/sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm --filter @vbdhub/db run build && tsc",
    "sync": "node dist/cli.js",
    "sync:gbif": "pnpm run sync -- --job gbif",
    "sync:hub": "pnpm run sync -- --job hub",
    "sync:px": "pnpm run sync -- --job px",
    "sync:vd": "pnpm run sync -- --job vd",
    "sync:vt": "pnpm run sync -- --job vt"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@vbdhub/db": "workspace:^",
    "csv-parse": "^6",
    "dotenv": "^17",
    "ky": "^2.0",
    "minio": "^8",
    "pino": "^10",
    "zod": "^4.3"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22",
    "@types/node": "^22",
    "typescript": "^5"
  }
}
